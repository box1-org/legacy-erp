#!/bin/sh
# Create an XFS filesystem on the ERP data disk only if it is blank: no signature
# found by `blkid -p` AND the first MiB is all zeroes. Anything else is left alone.
set -eu
DEV=/dev/disk/by-id/virtio-erpdata
[ -b "$DEV" ] || { echo "no ERP data disk at $DEV" >&2; exit 1; }
rc=0; blkid -p "$DEV" >/dev/null 2>&1 || rc=$?
case "$rc" in
  0) echo "ERP data disk already has a filesystem; not formatting"; exit 0 ;;
  2) ;;  # nothing detected
  *) echo "blkid -p failed on $DEV (exit $rc); not formatting" >&2; exit 1 ;;
esac
if [ "$(head -c 1048576 "$DEV" | tr -d '\000' | head -c 1 | wc -c)" -ne 0 ]; then
  echo "ERP data disk has no known signature but is not blank; refusing to format" >&2
  exit 1
fi
mkfs.xfs -q -L box1-erp-data "$DEV"
echo "Formatted blank ERP data disk $DEV (xfs, label box1-erp-data)"
